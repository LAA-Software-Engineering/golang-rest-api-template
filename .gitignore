# Binaries for programs and plugins
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out
coverage.out
coverage.html

# Built helper binary (use `go run ./scripts/generate_key.go`)
scripts/generate_key

# Go module cache / vendored dependencies (use go mod download instead)
vendor/
__pycache__
.pytest_cache
.env
.venv
# Anchor to repo root so vendored packages named "env" (e.g. otel) are not ignored.
/env
/venv
